"uniqueid": "OhtSENlOqWKFgYbpmqfRUSqxmUDdBe",
"value": "None"
},
{
"Class": "IntParameter",
"advanced": true,
"context": "solver",
"copy_for": false,
"description": "Iteration from which to continue the previous run (supports negative indexing: -1 will continue from the last iteration.  Does not affect failed_samples or acceptance_fractions)",
"kind": "emcee",
"limits": [
null,
null
],
"qualifier": "continue_from_iter",
"solver": "mcmc_physical",
